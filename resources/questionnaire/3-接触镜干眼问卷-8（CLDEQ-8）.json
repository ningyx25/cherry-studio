      "close_eyes_score": "Q4",
      "remove_lens_score": "(Q5 - 1) * 0.8"
    },
    "raw_total_score_formula": "Raw_Total = (Q1a + Q1b*2) + (Q2a + Q2b*2) + (Q3a + Q3b*2) + Q4 + ((Q5 - 1) * 0.8)",
    "raw_total_max": 37.2,
    "standardized_score_formula": "Standard_Score = (Raw_Total / 37.2) * 100",
    "diagnosis_cutoff": {
      "threshold_standard_score": 14,
      "positive_criteria": "Standard_Score >= 14.0",
      "clinical_significance": "得分 ≥ 14 分提示存在具有临床意义的接触镜相关干眼（Contact Lens-Related Dry Eye），需调整配戴方案或接受干眼干预。"
